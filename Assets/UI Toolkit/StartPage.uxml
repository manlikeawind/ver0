<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/USS/startPage.uss?fileID=7433441132597879392&amp;guid=8536519ddd745374bbe535a149ac8ad4&amp;type=3#startPage" />
    <ui:VisualElement name="MainPage" style="height: 100%; background-image: url(&apos;project://database/Assets/Texture/UI/background.png?fileID=2800000&amp;guid=e640e0027f161db43a11dc2e1bb54dd3&amp;type=3#background&apos;); flex-grow: 1; -unity-background-scale-mode: scale-and-crop; flex-basis: auto; flex-wrap: nowrap; justify-content: flex-start; align-items: auto; width: 100%; opacity: 1;">
        <ui:VisualElement name="btnGroup" style="margin-left: auto; margin-right: auto; margin-top: 30%; margin-bottom: 0; width: 100%; height: 100%;">
            <ui:Button text="Continue Game" display-tooltip-when-elided="true" name="continueGameBtn" class="btn" />
            <ui:Button text="New Game" display-tooltip-when-elided="true" name="startGameBtn" class="btn" />
            <ui:Button text="Setting" display-tooltip-when-elided="true" name="settingBtn" class="btn" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="SaveList" style="flex-grow: 1; flex-direction: column; position: absolute; width: 100%; height: 100%; background-color: rgba(56, 56, 56, 0.9); padding-top: 0; padding-left: 0; padding-right: 0; padding-bottom: 0;">
        <ui:VisualElement name="SaveTitle" style="height: 12%;">
            <ui:Label text="Saves" display-tooltip-when-elided="true" name="SaveTitleText" style="-unity-text-align: middle-center; font-size: 48px;" />
        </ui:VisualElement>
        <ui:VisualElement name="SaveItem" class="saveItem">
            <ui:Label text="Label" display-tooltip-when-elided="true" name="SaveItemTitle" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
